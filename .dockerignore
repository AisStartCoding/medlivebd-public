# Never in an image: installed dependencies (reinstalled inside), build output,
# test artefacts, local data, and any environment file — secrets arrive from
# deploy/.env at run time, never baked into a layer.
**/node_modules
**/.next
**/dist
**/coverage
**/*.tsbuildinfo
test-results
playwright-report
.git
.github
.env
.env.*
!.env.example
deploy/.env
deploy/backups
deploy/backups-second
storage

# Local archives, Python environments and test-only contract references.
.local
**/.venv
**/__pycache__
**/.pytest_cache
backend/tests
backend/env
testing
