{
  "name": "healthcare-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "National healthcare platform for Bangladesh \u2014 patient PWA, hospital consoles, and the live queue engine.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "node scripts/dev-all.mjs",
    "dev:api": "node scripts/dev-service.mjs api",
    "dev:django": "node scripts/dev-service.mjs api",
    "dev:site": "pnpm --filter @platform/site dev",
    "dev:console": "pnpm --filter @platform/console dev",
    "dev:patient": "pnpm --filter @platform/patient dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @platform/database migrate",
    "db:role": "pnpm --filter @platform/database role",
    "db:seed": "pnpm --filter @platform/database seed",
    "db:reset": "pnpm --filter @platform/database reset",
    "db:verify": "pnpm --filter @platform/database verify",
    "staff:create": "node scripts/backend-command.mjs create-staff",
    "doctor:verify": "node scripts/backend-command.mjs verify-doctor",
    "staff:reset-2fa": "node scripts/backend-command.mjs reset-two-factor",
    "mapping:try": "node scripts/backend-command.mjs try-mapping",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:fix": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project ui --project schema",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:built": "playwright test -c playwright.built.config.ts",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:django": "vitest run -c vitest.django.config.ts",
    "test:e2e:django": "playwright test -c playwright.django.config.ts",
    "test:e2e:refactor": "playwright test -c playwright.refactor.config.ts",
    "test:e2e:prod:django": "playwright test -c playwright.prod.django.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:backend",
    "clean": "pnpm -r exec rm -rf dist .next .turbo coverage *.tsbuildinfo",
    "test:backend": "node scripts/test-backend.mjs",
    "test:contracts": "vitest run -c vitest.django.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@platform/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^30.1.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
